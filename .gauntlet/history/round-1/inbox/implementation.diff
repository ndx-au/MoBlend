+	for _, key := range []string{"HOME", "XDG_CONFIG_HOME", "XDG_CACHE_HOME", "XDG_DATA_HOME", "TMPDIR"} {
+		env = append(env, key+"="+dir)
+	}
+	// Do not inherit Python startup paths, credentials, or Blender user scripts.
+	return env
+}
