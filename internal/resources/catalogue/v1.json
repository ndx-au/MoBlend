{
  "asset_pack_version": "0.1.0",
  "assets": [
    {
      "id": "base_cube",
      "type": "mesh",
      "display_name": "Base cube",
      "binding": {
        "object": "MoBlend_BaseCube",
        "material": "MoBlend_BaseMaterial"
      },
      "inputs": [],
      "animatable": ["location", "rotation_euler_deg", "scale", "material.base_color", "material.roughness"]
    },
    {
      "id": "column_chart",
      "type": "geometry_nodes",
      "display_name": "Column chart",
      "binding": {
        "object": "MoBlend_ColumnChart",
        "node_group": "MoBlend_ColumnChart",
        "modifier": "MoBlendChart",
        "sockets": {
          "geometry": "Socket_1",
          "bar_width": "Socket_2"
        },
        "point_attribute": "bar_value"
      },
      "inputs": [
        {
          "name": "values",
          "value_type": "number_array",
          "unit": "dimensionless",
          "min": 0,
          "max": 1,
          "animatable": false
        },
        {
          "name": "bar_count",
          "value_type": "integer",
          "unit": "count",
          "min": 1,
          "max": 12,
          "default": 5,
          "animatable": false
        },
        {
          "name": "bar_width",
          "value_type": "number",
          "unit": "metres",
          "min": 0.05,
          "max": 2,
          "default": 0.4,
          "binding": "Socket_2",
          "animatable": false
        }
      ],
      "animatable": ["location", "rotation_euler_deg", "scale", "material.base_color", "material.roughness"]
    }
  ]
}
