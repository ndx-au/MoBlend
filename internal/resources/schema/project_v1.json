{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ndx.video/moblend/schema/project_v1.json",
  "title": "MoBlend project manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_version", "kind", "entry", "modules"],
  "properties": {
    "project_version": { "type": "string", "const": "1.0.0" },
    "kind": { "type": "string", "const": "project" },
    "entry": { "type": "string", "minLength": 1 },
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "shots": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "entry"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "entry": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
