{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ndx.video/moblend/schema/v1.json",
  "title": "MoBlend scene declaration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "asset_pack_version", "scene", "camera", "objects"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "asset_pack_version": { "type": "string", "const": "0.1.0" },
    "scene": { "$ref": "#/$defs/scene" },
    "camera": { "$ref": "#/$defs/camera" },
    "lights": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/light" }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/object" }
    },
    "animation": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/track" }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_start", "frame_end", "fps", "resolution", "samples"],
      "properties": {
        "frame_start": { "type": "integer", "minimum": 0 },
        "frame_end": { "type": "integer", "minimum": 0 },
        "fps": { "type": "integer", "minimum": 1, "maximum": 120 },
        "resolution": {
          "type": "array",
          "prefixItems": [
            { "type": "integer", "minimum": 16, "maximum": 3840 },
            { "type": "integer", "minimum": 16, "maximum": 3840 }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "samples": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "world_color": { "$ref": "#/$defs/hexColor" }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "location", "rotation_euler_deg"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "location": { "$ref": "#/$defs/vec3" },
        "rotation_euler_deg": { "$ref": "#/$defs/vec3" },
        "focal_length_mm": { "type": "number", "exclusiveMinimum": 0, "maximum": 500 }
      }
    },
    "light": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "location", "energy"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "enum": ["AREA", "SUN", "POINT"] },
        "location": { "$ref": "#/$defs/vec3" },
        "rotation_euler_deg": { "$ref": "#/$defs/vec3" },
        "energy": { "type": "number", "minimum": 0 },
        "color": { "$ref": "#/$defs/hexColor" },
        "size": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_color"],
      "properties": {
        "base_color": { "$ref": "#/$defs/hexColor" },
        "roughness": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "enum": ["text", "form", "asset"] },
        "location": { "$ref": "#/$defs/vec3" },
        "rotation_euler_deg": { "$ref": "#/$defs/vec3" },
        "scale": { "$ref": "#/$defs/vec3" },
        "material": { "$ref": "#/$defs/material" },
        "text": { "type": "string", "minLength": 1, "maxLength": 256 },
        "form": { "type": "string", "enum": ["cube", "plane", "cylinder"] },
        "asset_id": { "type": "string", "minLength": 1 },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": ["number", "string", "boolean", "array"]
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "text" } }, "required": ["type"] },
          "then": { "required": ["text"] }
        },
        {
          "if": { "properties": { "type": { "const": "form" } }, "required": ["type"] },
          "then": { "required": ["form"] }
        },
        {
          "if": { "properties": { "type": { "const": "asset" } }, "required": ["type"] },
          "then": { "required": ["asset_id"] }
        }
      ]
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "property", "keys"],
      "properties": {
        "target_id": { "$ref": "#/$defs/id" },
        "property": {
          "type": "string",
          "enum": [
            "location",
            "rotation_euler_deg",
            "scale",
            "material.base_color",
            "material.roughness",
            "param"
          ]
        },
        "param_name": { "type": "string", "minLength": 1 },
        "interpolation": {
          "type": "string",
          "enum": ["step", "linear", "ease_in_out"]
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["frame", "value"],
            "properties": {
              "frame": { "type": "integer" },
              "value": {}
            }
          }
        }
      }
    }
  }
}
